# Salin ke .env.docker lalu isi nilainya. JANGAN di-commit / dibagikan.

APP_NAME=TunasTaniMakmur
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# Buat dengan: docker compose run --rm app php artisan key:generate --show
APP_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Laravel -> database (DB_HOST harus "db" = nama service di compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ttmpos
DB_USERNAME=ttm
DB_PASSWORD=ganti-password-ini

# --- Container MySQL (nilainya HARUS sama dengan DB_* di atas) ---
MYSQL_DATABASE=ttmpos
MYSQL_USER=ttm
MYSQL_PASSWORD=ganti-password-ini
MYSQL_ROOT_PASSWORD=ganti-root-password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

STORE_NAME=TunasTaniMakmur
STORE_ADDRESS=
STORE_PHONE=

# true = jalankan php artisan migrate --force tiap container start
RUN_MIGRATIONS=true
